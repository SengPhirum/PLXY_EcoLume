<%- include('partials/head', { title, page, user }) %>
<section class="summary-strip">
  <div class="summary-card feature">
    <div><p>Network availability</p><strong><%= fleet.total > 0 ? ((Number(fleet.online) / Number(fleet.total)) * 100).toFixed(1) : '0.0' %><small>%</small></strong></div>
    <span class="pulse-ring"><i></i></span>
  </div>
  <div class="summary-card"><p>Managed lights</p><strong><%= Number(fleet.total).toLocaleString() %></strong><small><b class="dot ok"></b><%= fleet.online %> online</small></div>
  <div class="summary-card"><p>Needs attention</p><strong class="amber"><%= Number(fleet.offline) + Number(fleet.fault) %></strong><small><b class="dot amber-bg"></b><%= fleet.offline %> offline · <%= fleet.fault %> fault</small></div>
  <div class="summary-card"><p>Open alerts</p><strong class="red"><%= alerts.total %></strong><small><b class="dot red-bg"></b><%= alerts.critical %> critical</small></div>
  <div class="summary-card"><p>Energy today</p><strong><%= energy.today_kwh %><small> kWh</small></strong><small><%= workOrders.open %> active work orders</small></div>
</section>

<div class="dashboard-grid">
  <section class="panel map-panel">
    <div class="panel-head">
      <div>
        <p class="eyebrow">Live fleet</p>
        <h2><%= map ? (map.kind === 'country' ? map.countryName : map.label) : 'Operations map' %></h2>
      </div>
      <div class="map-controls">
        <form class="map-region" method="get" action="/">
          <label class="visually-hidden" for="region">Map region</label>
          <select id="region" name="region" onchange="this.form.submit()">
            <% regions.forEach(option => { %>
              <option value="<%= option.code %>"<%= map && option.code === map.code ? ' selected' : '' %>><%= option.label %></option>
            <% }) %>
          </select>
          <noscript><button class="button small secondary" type="submit">Show</button></noscript>
        </form>
        <a class="text-link" href="/lights">View all assets →</a>
      </div>
    </div>
    <% if (!map) { %>
      <div class="empty-state">No boundary data is installed for this region.</div>
    <% } else { %>
      <div class="operation-map">
        <svg class="map-canvas" viewBox="<%= map.viewBox %>" preserveAspectRatio="xMidYMid meet"
             role="img" aria-label="<%= map.label %> with <%= map.lights.length %> mapped assets">
          <g class="map-shapes" stroke-width="<%= (map.height / 700).toFixed(4) %>">
            <% map.shapes.forEach(shape => { %>
              <% if (map.shapes.length > 1) { %>
                <a href="/?region=<%= map.country %>-<%= shape.code %>">
                  <path d="<%= shape.path %>"><title><%= shape.name %></title></path>
                </a>
              <% } else { %>
                <path d="<%= shape.path %>"><title><%= shape.name %></title></path>
              <% } %>
            <% }) %>
          </g>
          <g class="map-pins">
            <% map.lights.forEach(light => { %>
              <a href="/lights/<%= light.id %>">
                <circle class="map-pin <%= light.status.toLowerCase() %>"
                        cx="<%= light.x.toFixed(4) %>" cy="<%= light.y.toFixed(4) %>"
                        r="<%= (map.height / 85).toFixed(4) %>">
                  <title><%= light.asset_code %> · <%= light.status %></title>
                </circle>
              </a>
            <% }) %>
          </g>
        </svg>
        <div class="map-legend">
          <span><b class="dot ok"></b>Online</span>
          <span><b class="dot amber-bg"></b>Offline</span>
          <span><b class="dot red-bg"></b>Fault</span>
          <span><b class="dot violet-bg"></b>Maintenance</span>
        </div>
        <small class="map-caption"><%= map.lights.length %> mapped · <%= map.source %></small>
      </div>
      <% if (map.notice) { %><p class="map-notice"><%= map.notice %></p><% } %>
    <% } %>
  </section>

  <section class="panel alerts-panel">
    <div class="panel-head">
      <div><p class="eyebrow">Action queue</p><h2>Priority alerts</h2></div>
      <a class="text-link" href="/alerts">All alerts →</a>
    </div>
    <div class="alert-list">
      <% if (!recentAlerts.length) { %><div class="empty-state">No open alerts. The network is healthy.</div><% } %>
      <% recentAlerts.forEach(alert => { %>
        <a class="alert-row" href="/lights/<%= alert.light_id %>">
          <span class="severity-icon <%= alert.severity.toLowerCase() %>">!</span>
          <div><strong><%= alert.type.replaceAll('_', ' ') %></strong><p><%= alert.asset_code %> · <%= alert.province_name %></p></div>
          <time><%= new Date(alert.opened_at).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' }) %></time>
        </a>
      <% }) %>
    </div>
  </section>
</div>

<section class="panel province-panel">
  <div class="panel-head">
    <div><p class="eyebrow">Coverage</p><h2>Provincial readiness</h2></div>
    <a class="text-link" href="/provinces">Detailed view →</a>
  </div>
  <div class="province-grid">
    <% provinceStats.forEach(province => {
      const pct = Number(province.total) ? Math.round(Number(province.online) / Number(province.total) * 100) : 0;
    %>
      <div class="province-mini">
        <div><strong><%= province.code %></strong><span><%= province.name_en %></span><small><%= province.name_km %></small></div>
        <div class="mini-stat"><b><%= province.online %>/<%= province.total %></b><span class="progress"><i style="width:<%= pct %>%"></i></span></div>
      </div>
    <% }) %>
  </div>
</section>
<%- include('partials/foot') %>

