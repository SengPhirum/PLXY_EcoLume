NODE_ENV=development
PORT=8080
APP_BASE_URL=http://localhost:8080
DATABASE_URL=postgres://ecolume:replace-with-a-long-random-password@postgres:5432/ecolume
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-one-time-password
COOKIE_SECURE=false
SEED_DEMO_DATA=true

MQTT_ENABLED=true
MQTT_URL=mqtt://mosquitto:1883
MQTT_USERNAME=ecolume-backend
MQTT_PASSWORD=replace-with-a-long-random-password
MQTT_TOPIC_PREFIX=ecolume/v1

DEVICE_DEMO_TOKEN=replace-with-a-unique-device-token
# Operations map. "KH" shows all of Cambodia; "KH-PNH" opens on one province.
# Boundary data is self-hosted in backend/src/public/geo, so no tile service is
# contacted and the control room keeps working without internet access.
MAP_REGION=KH

OFFLINE_AFTER_MINUTES=15
TELEMETRY_RETENTION_DAYS=365

